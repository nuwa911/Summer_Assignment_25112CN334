//Function to Find Sum of Two Numbers

#include<stdio.h>
int sum(int a,int b){
return a+b;
}
int main(){
int a,b;
scanf("%d%d",&a,&b);
printf("%d",sum(a,b));
return 0;
}

//Write Function to Find Maximum

#include<stdio.h>
int max(int a,int b){
if(a>b)
return a;
return b;
}
int main(){
int a,b;
scanf("%d%d",&a,&b);
printf("%d",max(a,b));
return 0;
}

//Write Function to Check Prime

#include<stdio.h>
int prime(int n){
int i;
if(n<2)
return 0;
for(i=2;i<n;i++){
if(n%i==0)
return 0;
}
return 1;
}
int main(){
int n;
scanf("%d",&n);
if(prime(n))
printf("Prime");
else
printf("Not Prime");
return 0;
}

//Write Function to Find Factorial

#include<stdio.h>
int fact(int n){
int i,f=1;
for(i=1;i<=n;i++)
f*=i;
return f;
}
int main(){
int n;
scanf("%d",&n);
printf("%d",fact(n));
return 0;
}







