//Student Record System Using Arrays and Strings

#include<stdio.h>
int main(){
int roll[10],n,i;
char name[10][50];
scanf("%d",&n);
for(i=0;i<n;i++)
scanf("%d%s",&roll[i],name[i]);
for(i=0;i<n;i++)
printf("%d %s\n",roll[i],name[i]);
return 0;
}



//Mini Library System


#include<stdio.h>
struct book{
int id;
char name[50];
};
int main(){
struct book b[10];
int n,i;
scanf("%d",&n);
for(i=0;i<n;i++)
scanf("%d%s",&b[i].id,b[i].name);
for(i=0;i<n;i++)
printf("%d %s\n",b[i].id,b[i].name);
return 0;
}


//. Mini Employee Management System

#include<stdio.h>
struct employee{
int id;
char name[50];
float salary;
};
int main(){
struct employee e[10];
int n,i;
scanf("%d",&n);
for(i=0;i<n;i++)
scanf("%d%s%f",&e[i].id,e[i].name,&e[i].salary);
for(i=0;i<n;i++)
printf("%d %s %.2f\n",e[i].id,e[i].name,e[i].salary);
return 0;
}
