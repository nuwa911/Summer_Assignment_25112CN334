//Write the output of the following code: 
// Question 1. Sum of n natural numbers 
 #include<stdio.h>
 int main (){
 int n;
 printf("Enter the value of n : ");
 scanf("%d",&n);
 int sum = 0;
 for(int i=0; i<=n; i++){
 sum = sum + i;}
 printf("The Sum of %d natural numbers is %d ",n,sum);
 return 0;
 }
