//Union of Arrays

#include<stdio.h>
int main(){
int a[100],b[100],n,m,i,j,f;
scanf("%d",&n);
for(i=0;i<n;i++)
scanf("%d",&a[i]);
scanf("%d",&m);
for(i=0;i<m;i++)
scanf("%d",&b[i]);
for(i=0;i<n;i++)
printf("%d ",a[i]);
for(i=0;i<m;i++){
f=0;
for(j=0;j<n;j++){
if(b[i]==a[j]){
f=1;
break;
}
}
if(f==0)
printf("%d ",b[i]);
}
return 0;
}
