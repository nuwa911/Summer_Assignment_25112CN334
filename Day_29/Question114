//Menu-Driven Array Operations

#include<stdio.h>
int main(){
int a[100],n,i,ch,s=0;
scanf("%d",&n);
for(i=0;i<n;i++)
scanf("%d",&a[i]);
scanf("%d",&ch);
switch(ch){
case 1:
for(i=0;i<n;i++)
printf("%d ",a[i]);
break;
case 2:
for(i=0;i<n;i++)
s+=a[i];
printf("%d",s);
break;
case 3:
for(i=n-1;i>=0;i--)
printf("%d ",a[i]);
break;
}
return 0;
}
